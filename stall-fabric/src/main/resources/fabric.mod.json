{
  "schemaVersion": 1,
  "id": "stall",
  "version": "${version}",
  "name": "Stall",
  "description": "Physical player shops. Turn a barrel or chest into a shop, stock it, and trade with other players. Runs on the server; vanilla clients need nothing installed.",
  "authors": [
    "castledking"
  ],
  "contact": {
    "homepage": "https://castled.codes",
    "issues": "https://github.com/castledking/Stall/issues",
    "sources": "https://github.com/castledking/Stall"
  },
  "icon": "assets/stall/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "codes.castled.stall.fabric.StallFabric"
    ]
  },
  "mixins": [
    "stall.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderMinimum}",
    "minecraft": "${minecraftDependency}",
    "java": ">=${javaVersion}",
    "fabric-api-base": "*",
    "fabric-command-api-v2": "*",
    "fabric-data-attachment-api-v1": "*",
    "fabric-events-interaction-v0": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-networking-api-v1": "*",
    "fabric-permission-api-v1": "*"
  }
}
